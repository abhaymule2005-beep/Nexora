# Nexora Environment Configuration

APP_ENV=development
APP_NAME=Nexora
PORT=8000
DEBUG=True

# SQLite for local development (can be switched to PostgreSQL)
DATABASE_URL=sqlite:///./nexora.db

# Optional LLM integration (OpenAI-compatible)
# Fallback deterministic NLP parser is used if not provided
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Optional Geoapify API Key (Fallback uses geodesic Haversine distance matrix)
GEOAPIFY_API_KEY=

# Weather provider (Open-Meteo works without an API key)
WEATHER_PROVIDER=open_meteo
